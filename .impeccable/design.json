      "css": ".ds-ghost{display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border:0;border-radius:6px;background:transparent;color:var(--foreground,#193c35);cursor:pointer;transition:background .15s,box-shadow .15s}.ds-ghost:hover{background:var(--accent,#eaf3d3);color:var(--primary,#193c35)}.ds-ghost:focus-visible{outline:3px solid color-mix(in srgb,var(--primary,#193c35) 50%,transparent);outline-offset:2px;}.ds-ghost:active{filter:brightness(.95)}"
