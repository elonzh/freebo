      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The main action in setup and server forms.",
      "html": "<button class=\"ds-primary\">Start setup</button>",
      "css": ".ds-primary{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"Noto Sans\",sans-serif;height:36px;padding:8px 16px;border:0;border-radius:6px;background:var(--primary,#193c35);color:var(--primary-foreground,#fbfcf9);font-size:14px;font-weight:500;cursor:pointer;transition:background .15s,box-shadow .15s}.ds-primary:hover{background:color-mix(in srgb,var(--primary,#193c35) 90%,transparent)}.ds-primary:focus-visible{outline:3px solid color-mix(in srgb,var(--primary,#193c35) 50%,transparent);outline-offset:2px;}.ds-primary:active{filter:brightness(.95)}.ds-primary:disabled{opacity:.5;pointer-events:none}"
    },
