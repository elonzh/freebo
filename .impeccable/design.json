      "description": "Labeled URL-friendly input with a visible focus ring.",
      "html": "<label class=\"ds-field\">Server address<input type=\"text\" inputmode=\"url\" placeholder=\"https://emby.example.com\" /></label>",
      "css": ".ds-field{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"Noto Sans\",sans-serif;display:grid;gap:10px;color:var(--foreground,#193c35);font-size:14px;font-weight:500}.ds-field input{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"Noto Sans\",sans-serif;height:36px;width:100%;min-width:0;padding:4px 12px;border:1px solid var(--input,#a8b99f);border-radius:6px;background:transparent;color:var(--foreground,#193c35);font-size:14px;box-shadow:0 1px 2px rgb(0 0 0 / .05);transition:border-color .15s,box-shadow .15s}.ds-field input::placeholder{color:var(--muted-foreground,#52675b)}.ds-field input:hover{border-color:var(--primary,#193c35)}.ds-field input:focus-visible{outline:3px solid color-mix(in srgb,var(--primary,#193c35) 50%,transparent);outline-offset:2px;border-color:var(--primary,#193c35)}"
    },
    {
      "name": "Settings navigation",
      "kind": "nav",
      "refersTo": "navigation-settings-active",
      "description": "One selected utility panel with a rounded right edge.",
      "html": "<nav class=\"ds-settings\" aria-label=\"Settings\"><button aria-current=\"page\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"2\" y=\"3\" width=\"20\" height=\"14\" rx=\"2\"/><path d=\"M8 21h8M12 17v4\"/></svg><span>Players</span></button><button><span>Appearance and language</span></button></nav>",
      "css": ".ds-settings{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"Noto Sans\",sans-serif;display:grid;gap:3px;width:190px}.ds-settings button{display:flex;align-items:center;gap:12px;padding:12px 16px;border:0;border-radius:0 22px 22px 0;background:transparent;color:var(--muted-foreground,#52675b);text-align:left;font-family:inherit;font-size:13px;font-weight:500;cursor:pointer;transition:background .15s}.ds-settings span{min-width:0;white-space:normal;line-height:1.5}.ds-settings button[aria-current=\"page\"],.ds-settings button:hover{background:var(--accent,#eaf3d3);color:var(--primary,#193c35)}.ds-settings button:focus-visible{outline:3px solid color-mix(in srgb,var(--primary,#193c35) 50%,transparent);outline-offset:2px;}"
    },
    {
      "name": "Server form",
      "kind": "card",
      "refersTo": "form-server",
      "description": "A flat bordered form; use its larger corner only for containers.",
      "html": "<section class=\"ds-form\"><h2>Add server</h2><p>Sign in on the Emby website after adding the address.</p><a href=\"#server\">Set up server</a></section>",
      "css": ".ds-form{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"Noto Sans\",sans-serif;max-width:510px;padding:24px;border:1px solid var(--border,#d8e1d3);border-radius:12px;background:var(--card,#ffffff);color:var(--foreground,#193c35)}.ds-form h2{margin:0 0 26px;font-size:17px;line-height:1.4;font-weight:600}.ds-form p{margin:0 0 22px;color:var(--muted-foreground,#52675b);font-size:13px;line-height:1.625}.ds-form a{color:var(--primary,#193c35);font-size:14px;text-underline-offset:4px}.ds-form a:hover{text-decoration:underline}.ds-form a:focus-visible{outline:3px solid color-mix(in srgb,var(--primary,#193c35) 50%,transparent);outline-offset:2px;}"
    },
    {
      "name": "Browser tab",
      "kind": "nav",
      "refersTo": "browser-tab-active",
      "description": "The active tab joins the toolbar beneath it.",
      "html": "<div class=\"ds-tabstrip\"><button class=\"ds-tab\" aria-current=\"page\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M2 12h20M12 2a18 18 0 0 1 0 20 18 18 0 0 1 0-20\"/></svg><span>My server</span></button></div>",
      "css": ".ds-tabstrip{display:flex;align-items:flex-end;padding:6px 10px 0;background:var(--tab-strip,#e0e8db)}.ds-tab{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"Noto Sans\",sans-serif;display:flex;align-items:center;gap:9px;width:190px;height:34px;padding:0 13px;border:0;border-radius:9px 9px 0 0;background:var(--toolbar,#ffffff);color:var(--foreground,#193c35);font-size:12px;cursor:pointer}.ds-tab span{overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.ds-tab:hover{background:var(--secondary,#edf3e8)}.ds-tab:focus-visible{outline:3px solid color-mix(in srgb,var(--primary,#193c35) 50%,transparent);outline-offset:2px;}"
    },
    {
      "name": "Switch",
      "kind": "custom",
      "refersTo": "switch-checked",
      "description": "A compact boolean setting with a moving thumb.",
      "html": "<label class=\"ds-switch\"><input type=\"checkbox\" checked aria-label=\"Continuous playback\" /><span class=\"ds-switch-track\"></span></label>",
      "css": ".ds-switch{display:inline-flex;position:relative;cursor:pointer}.ds-switch input{position:absolute;opacity:0;width:32px;height:18.4px;margin:0}.ds-switch-track{display:block;width:32px;height:1.15rem;border:1px solid transparent;border-radius:9999px;background:var(--input,#a8b99f);box-shadow:0 1px 2px rgb(0 0 0 / .05);transition:background .15s}.ds-switch-track::before{content:\"\";display:block;width:16px;height:16px;border-radius:50%;background:var(--background,#fbfcf9);transition:transform .15s}.ds-switch input:checked+.ds-switch-track{background:var(--primary,#193c35)}.ds-switch input:checked+.ds-switch-track::before{transform:translateX(14px)}.ds-switch input:focus-visible+.ds-switch-track{outline:3px solid color-mix(in srgb,var(--primary,#193c35) 50%,transparent);outline-offset:2px;}.ds-switch:hover .ds-switch-track{filter:brightness(.95)}"
    }
  ],
  "narrative": {
    "northStar": "The friendly guide dog",
    "overview": "Freebo pairs the approved guide-dog mark with Atma SemiBold. Deep pine gives the identity a steady outline; lime provides a clear, lively point of recognition. The asymmetric ears and friendly expression belong to the mark's identity. Use the supplied vector family for the name, logo and app icon, with Freebo capitalized in every locale.\n\nThe identity sits within the user's confirmed Chrome desktop layout: tabs above a navigation toolbar and rounded address field. Warm green surfaces carry compact utility pages. System typography keeps instructions and controls readable in Chinese and English; the character font is reserved for the product name in application chrome. Emby owns its library and sign-in interface in a native guest view. Freebo owns server management, setup, playback controls and recovery.",
    "keyCharacteristics": [
      "An approved guide-dog mark and a real Atma 600 wordmark.",
      "Deep pine, lime and paper, with semantic light/dark utility surfaces.",
      "A two-row desktop browser shell with native operating-system controls.",
      "Flat, compact settings and server rows; temporary playback in a native floating window."
    ],
    "rules": [
      {
        "name": "The Semantic Appearance Rule",
        "body": "Use semantic CSS variables and shadcn variants for owned controls. Follow system or explicit app appearance. Emby's appearance remains controlled by Emby.",
        "section": "colors"
      },
      {
        "name": "The Name Type Rule",
        "body": "Within the application, Atma spells Freebo. Instructions, URLs, settings and translated copy use the system UI stack. The independent brand-kit page may use its documented Atma display heading.",
        "section": "typography"
      },
      {
        "name": "The Native Geometry Rule",
        "body": "The Emby guest begins below the 88px shell and moves down by 64px when a server or generic recovery bar appears. Playback controls and queue stay in a separate native window and do not subtract from the guest's size.",
        "section": "layout"
      },
      {
        "name": "The Task Depth Rule",
        "body": "Keep routine settings flat. Use a native window for the temporary playback task layer.",
        "section": "elevation"
      },
      {
        "name": "The Purposeful Motion Rule",
        "body": "Loading rotation, switch feedback and shared control transitions communicate state. Honor reduced motion by disabling animation and transition in owned UI.",
        "section": "components"
      }
    ],
    "dos": [
      "Do use the approved vector logo family, Atma 600 and the bundled font license.",
      "Do keep Freebo capitalized in every locale and in all brand materials.",
      "Do preserve Chrome-style desktop tabs, navigation and the rounded address field.",
      "Do keep shell and recovery geometry synchronized with native guest bounds.",
      "Do use shadcn controls and existing semantic variables for both appearances.",
      "Do keep translated labels, keyboard focus and action-specific icon names readable.",
      "Do use clean actual-app screenshots and state their validation scope."
    ],
    "donts": [
      "Don't redraw the wordmark, stretch the mark or add a Chinese alias to brand assets.",
      "Don't use a grayscale filter as a substitute for the supplied monochrome vector cutouts.",
      "Don't apply Atma to utility instructions, settings or Emby's interface.",
      "Don't restyle Emby's library/account pages as Freebo chrome.",
      "Don't turn ordinary settings and server rows into decorative elevated card grids.",
      "Don't treat closing a tab as deletion of its registered server.",
      "Don't infer native window resizing, real playback or cross-platform acceptance from CSS captures."
    ]
  }
}
